# 서버 포트 (CLI --port 가 있으면 그것이 우선)
PORT=8888
# 바인딩 주소
#  - 127.0.0.1 : 이 컴퓨터 안에서만 접속 (노트북 단독 사용, 같은 서버의 nginx 뒤에 둘 때)
#  - 0.0.0.0   : 모든 대역 (Docker 컨테이너, 같은 와이파이의 다른 기기에서 접속할 때)
#    Docker 안에서 127.0.0.1 로 두면 오류 없이 떠 있지만 밖에서 접속이 안 된다.
HOST=0.0.0.0
# error | warn | info | debug
LOG_LEVEL=info
NODE_ENV=production
# 사회자 비밀번호 (필수). 콘솔 · 설정 화면에 들어갈 때 입력한다. 없으면 서버가 뜨지 않는다
ADMIN_PASSWORD=change-me
# 설정 · 게임 상태 JSON 파일을 저장할 폴더. Docker 라면 이 폴더를 볼륨으로 연결해야 데이터가 남는다
DATA_DIR=./data
